# Copy this file to .env and fill in real values. Never commit .env.

# CouchDB admin — used by the couchdb and hook services
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-to-something-long-and-random

# Obsidian web UI login (only used while the `obsidian` container is running)
WEB_USER=admin
WEB_PASSWORD=change-me-too

# Bearer token the hook expects on POST /report — generate with:
#   openssl rand -hex 24
HOOK_TOKEN=change-me-to-a-random-token

# Timezone for daily-note dates in the hook (IANA name, e.g. America/New_York)
TZ=UTC
